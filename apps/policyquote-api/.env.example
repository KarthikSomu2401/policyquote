# Local API runtime settings. Nx loads .env files for project tasks.
POLICYQUOTE_API_PORT=3000

# Use the checked-in local KB for Nx, Docker and SAM development.
POLICYQUOTE_KB_SOURCE=local
POLICYQUOTE_KB_REFRESH_INTERVAL_MS=30000

# Production only: set POLICYQUOTE_KB_SOURCE=appconfig and provide the AppConfig path.
APPCONFIG_AGENT_URL=http://localhost:2772
APPCONFIG_APPLICATION=your-appconfig-application
APPCONFIG_ENVIRONMENT=your-appconfig-environment
APPCONFIG_CONFIGURATION=your-appconfig-configuration